# Dependencies
node_modules/

# The local OpenMAIC checkout: cloned by scripts/setup-openmaic.mjs and built
# there. It is never part of this package.
vendor/

# Plugin-local runtime state: the embedded PostgreSQL data directory (every
# course lives here) and scratch output from the checks.
runtime/
*.log

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Browser probes written by scripts/frame-check.mjs
.frame-check-profile/
.frame-check.png
.asar.mjs
runtime/panel-geometry.json
.render-check-profile/
.render-check.png
.srcdoc-check-profile/
.srcdoc-check.png
.srcdoc-render-profile/
.srcdoc-render.png
.srcdoc-payload.html
.embed-check-profile/
.embed-check.png
panel.html

# Browser probe profiles and screenshots written by the check scripts. Anchored
# with a dot prefix so a single rule covers every future probe name instead of
# one line per script (an unlisted profile was committed once already).
.*-profile/
.*-profile-*/
.*-check.png
.*-check-profile/

# Probe profiles and screenshots from the browser checks
.embed-profile/
.embed-check.png
.srcdoc-base-profile/
.srcdoc-base-check.png
.bridge-profile/
.bridge-check.png
.diag-profile/
