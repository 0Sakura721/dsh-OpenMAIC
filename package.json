{
  "name": "dsh-openmaic",
  "version": "0.1.0",
  "description": "Run THU-MAIC/OpenMAIC fully locally inside DeepSeek Harness: an embedded PGlite-backed PostgreSQL, a managed Next.js server, a sidebar panel that frames the classroom app, and an agent tool that reports its state.",
  "license": "MIT",
  "author": "0Sakura721",
  "homepage": "https://github.com/0Sakura721/dsh-OpenMAIC#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Sakura721/dsh-OpenMAIC.git"
  },
  "bugs": {
    "url": "https://github.com/0Sakura721/dsh-OpenMAIC/issues"
  },
  "icon": "assets/icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "openmaic",
    "classroom",
    "local-first",
    "pglite"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18"
  },
  "devDependencies": {
    "pg": "8.22.0"
  }
}
